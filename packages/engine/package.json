{
  "name": "@shortest/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./solver": "./src/solver.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build:puzzles": "tsx scripts/build-puzzles.ts",
    "test": "node --import tsx --input-type=module -e \"await import('./test/characterization.test.ts'); await import('./test/competitive.test.ts'); await import('./test/rogue-v1.test.ts')\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ../../supabase/tsconfig.json",
    "simulate:rogue-v1": "node --import tsx scripts/simulate-rogue-v1.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
